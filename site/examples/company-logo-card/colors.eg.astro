---
import { CompanyLogoCard } from '@webf/astro-ui';

import GoogleLogo from '../../assets/company-logos/google.svg';
import GitHubLogo from '../../assets/company-logos/github.svg';
import DropboxLogo from '../../assets/company-logos/dropbox.svg';
import AmazonLogo from '../../assets/company-logos/amazon.svg';
---

<div class:list={['grid grid-cols-2 gap-4 sm:grid-cols-3 xl:grid-cols-5']}>
  <CompanyLogoCard variant='purple' companyName='Google' logo={GoogleLogo} />

  <CompanyLogoCard variant='orange' companyName='GitHub' logo={GitHubLogo} />

  <CompanyLogoCard variant='green' companyName='Spotify' logo={DropboxLogo} />

  <CompanyLogoCard variant='blue' companyName='Microsoft' logo={AmazonLogo} />

  <CompanyLogoCard variant='neutral' companyName='Figma' logo={GoogleLogo} />
</div>
