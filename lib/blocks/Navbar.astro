---
import { ChevronDown } from 'lucide-astro';

import Link from './Link.astro';

interface NavItem {
  label: string;
  href: string;
  hasDropdown?: boolean;
}

interface Props {
  logoSrc?: string;
  logoText?: string;
  navItems?: NavItem[];
  class?: string;
  style?: string;
  position?: 'fixed' | 'sticky' | 'static';
}

const {
  logoSrc,
  logoText,
  navItems = [],
  class: className = '',
  style = '',
  position = 'fixed',
  ...rest
} = Astro.props;
---

<nav
  class:list={[
    'bg-surface left-0 w-full shadow-sm',
    {
      'fixed top-0 z-50': position === 'fixed',
      'sticky top-0 z-50': position === 'sticky',
      relative: position === 'static',
    },
    className,
  ]}
  style={style}
  {...rest}
>
  <div class='mx-auto max-w-screen-2xl px-8'>
    <div class='flex h-20 items-center justify-between'>
      <a href='/' class='flex items-center'>
        {
          logoSrc && (
            <img src={logoSrc} alt='Logo' class='h-12 w-auto object-contain' />
          )
        }

        {
          !logoSrc && logoText && (
            <span class='text-foreground text-2xl font-bold'>{logoText}</span>
          )
        }
      </a>

      <div class='flex items-center gap-8'>
        {
          navItems.map((item) => (
            <a
              href={item.href}
              class='text-foreground flex items-center gap-1 text-base font-medium transition-colors'
            >
              <span>{item.label}</span>

              {item.hasDropdown && <ChevronDown size={16} strokeWidth={2} />}
            </a>
          ))
        }
      </div>

      <div class='flex items-center gap-5'>
        <Link variant='purple'>Apply Now</Link>
      </div>
    </div>
  </div>
</nav>
