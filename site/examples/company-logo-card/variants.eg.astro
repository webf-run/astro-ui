---
import { CompanyLogoCard } from '@webf/astro-ui';

import GoogleLogo from '../../assets/company-logos/google.svg';
import GitHubLogo from '../../assets/company-logos/github.svg';
import DropboxLogo from '../../assets/company-logos/dropbox.svg';
import AmazonLogo from '../../assets/company-logos/amazon.svg';
---

<div class:list={['grid grid-cols-2 gap-4 md:grid-cols-3']}>
  <CompanyLogoCard variant='default' companyName='Google' logo={GoogleLogo} />

  <CompanyLogoCard variant='muted' companyName='GitHub' logo={GitHubLogo} />

  <CompanyLogoCard
    variant='accent'
    companyName='Microsoft'
    logo={DropboxLogo}
  />

  <CompanyLogoCard variant='purple' companyName='Figma' logo={AmazonLogo} />

  <CompanyLogoCard variant='green' companyName='Spotify' logo={GoogleLogo} />

  <CompanyLogoCard variant='orange' companyName='Amazon' logo={GitHubLogo} />

  <CompanyLogoCard variant='blue' companyName='Dropbox' logo={DropboxLogo} />

  <CompanyLogoCard variant='neutral' companyName='Slack' logo={AmazonLogo} />
</div>
