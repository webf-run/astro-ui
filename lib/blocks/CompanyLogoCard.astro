---
import { cva, type VariantProps } from 'class-variance-authority';

const companyLogoCardVariants = cva(
  'flex w-full items-center justify-center rounded-xl border transition-all duration-200',
  {
    variants: {
      variant: {
        default: 'border-border bg-surface',
        muted: 'border-border-subtle bg-surface-muted',
        accent: 'border-surface-accent-strong bg-surface-accent',
        purple:
          'border-badge-purple-background bg-badge-purple-background',
        orange:
          'border-badge-orange-background bg-badge-orange-background',
        green: 'border-badge-green-background bg-badge-green-background',
        blue: 'border-badge-blue-background bg-badge-blue-background',
        neutral: 'border-badge-neutral-background bg-badge-neutral-background',
      },
      size: {
        sm: 'aspect-square p-3',
        md: 'aspect-video p-4',
        lg: 'aspect-video p-6',
      },
      effect: {
        none: '',
        lift: 'hover:-translate-y-1 hover:shadow-lg',
        scale: 'hover:scale-105',
      },
    },
    defaultVariants: {
      variant: 'default',
      size: 'md',
      effect: 'scale',
    },
  }
);

interface Props extends VariantProps<typeof companyLogoCardVariants> {
  logo: string;
  companyName: string;
  href?: string;
  class?: string;
}

const {
  logo,
  companyName,
  href,
  variant,
  size,
  effect,
  class: className = '',
} = Astro.props;
---

{
  href ? (
    <a
      href={href}
      target='_blank'
      rel='noopener noreferrer'
      class:list={[companyLogoCardVariants({ variant, size, effect }), className]}
      aria-label={`Visit ${companyName}`}
    >
      <img
        src={logo}
        alt={`${companyName} logo`}
        class:list={['max-h-12 w-auto max-w-full object-contain']}
      />
    </a>
  ) : (
    <div class:list={[companyLogoCardVariants({ variant, size, effect }), className]}>
      <img
        src={logo}
        alt={`${companyName} logo`}
        class:list={['max-h-12 w-auto max-w-full object-contain']}
      />
    </div>
  )
}
