---
import type { Users } from 'lucide-astro';

interface Props {
  icon: typeof Users;
  value: string;
  label: string;
  class?: string;
}

const { icon: Icon, value, label, class: className = '' }: Props = Astro.props;
---

<div
  class:list={[
    'border-border bg-surface-muted mx-auto w-full rounded-xl border px-3 py-4 text-center sm:max-w-56 lg:max-w-none',
    className,
  ]}
>
  <Icon class='text-icon mx-auto mb-2 h-5 w-5' />
  <h3 class='text-lg font-bold whitespace-nowrap sm:text-xl'>{value}</h3>
  <p class='text-foreground-muted text-xs'>{label}</p>
</div>
