---
import { ChevronDown } from 'lucide-astro';

import Link from './Link.astro';

interface NavItem {
  label: string;
  href: string;
  hasDropdown?: boolean;
}

interface Props {
  logoSrc?: string;
  logoText?: string;
  navItems?: NavItem[];
  class?: string;
  style?: string;
  position?: 'fixed' | 'sticky' | 'static';
}

const {
  logoSrc,
  logoText,
  navItems = [],
  class: className = '',
  style = '',
  position = 'fixed',
  ...rest
} = Astro.props;
---

<nav
  class:list={[
    'bg-surface left-0 w-full shadow-sm',
    {
      'fixed top-0 z-50': position === 'fixed',
      'sticky top-0 z-50': position === 'sticky',
      relative: position === 'static',
    },
    className,
  ]}
  style={style}
  {...rest}
>
  <div class='mx-auto max-w-screen-2xl px-4 sm:px-6 lg:px-8'>
    <div class='flex h-16 items-center justify-between sm:h-20'>
      <a href='/' class:list={['flex items-center']}>
        <slot name='logo'>
          {
            logoSrc && (
              <img
                src={logoSrc}
                alt='Logo'
                class='h-10 w-auto object-contain sm:h-12'
              />
            )
          }

          {
            !logoSrc && logoText && (
              <span class='text-foreground text-xl font-bold sm:text-2xl'>
                {logoText}
              </span>
            )
          }
        </slot>
      </a>

      <div class='flex items-center gap-4 md:gap-6 lg:gap-8'>
        {
          navItems.map((item) => (
            <a
              href={item.href}
              class:list={[
                'text-foreground hover:text-foreground-muted flex items-center gap-1 text-xs font-medium transition-colors sm:text-sm lg:text-base',
              ]}
            >
              <span>{item.label}</span>

              {item.hasDropdown && <ChevronDown size={16} strokeWidth={2} />}
            </a>
          ))
        }
      </div>

      <div class='flex items-center gap-3 sm:gap-5'>
        <slot name='actions'>
          <Link variant='purple'>Apply Now</Link>
        </slot>
      </div>
    </div>
  </div>
</nav>
