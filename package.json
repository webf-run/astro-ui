{
  "name": "@webf/astro-ui",
  "private": true,
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/webf-run/astro-ui.git"
  },
  "homepage": "https://github.com/webf-run/astro-ui",
  "bugs": {
    "url": "https://github.com/webf-run/astro-ui/issues"
  },
  "packageManager": "pnpm@11.10.0",
  "type": "module",
  "scripts": {
    "check": "astro check && pnpm run check:types",
    "check:types": "tsc --noEmit",
    "build:css": "tailwindcss -i ./lib/styles/index.css -o ./dist/style.css --minify && node -e \"require('fs').copyFileSync('dist/style.css','public/astro-ui-style.css')\"",
    "build:playground": "node scripts/build-playground.ts",
    "prebuild": "pnpm run build:playground",
    "build": "astro build",
    "predev": "pnpm run build:playground",
    "dev": "astro dev",
    "lint": "pnpm -r lint",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "preview": "astro preview"
  },
  "exports": {
    ".": "./lib/index.ts",
    "./style.css": "./dist/style.css"
  },
  "dependencies": {
    "@codemirror/language": "^6.12.4",
    "@lezer/common": "^1.5.2",
    "@lucide/astro": "^1.23.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.2",
    "astro": "^7.0.6",
    "lucide-astro": "^0.556.0",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/compiler": "^4.0.0",
    "@astrojs/mdx": "^7.0.2",
    "@astrojs/solid-js": "^7.0.1",
    "@astrojs/starlight": "^0.41.2",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-html": "^6.4.9",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/state": "^6.4.1",
    "@codemirror/theme-one-dark": "^6.1.2",
    "@codemirror/view": "^6.34.0",
    "@fontsource-variable/ibm-plex-sans": "^5.2.8",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@tailwindcss/cli": "^4.3.2",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@webcontainer/api": "^1.6.4",
    "astro": "^7.0.0",
    "esbuild-wasm": "^0.25.1",
    "lucide-solid": "^1.25.0",
    "prettier": "^3.9.4",
    "prettier-plugin-astro": "^0.14.1",
    "solid-js": "^1.9.14",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3"
  },
  "keywords": [
    "astro",
    "ui",
    "components",
    "tailwindcss"
  ]
}
