---
import { Users } from 'lucide-astro';

interface Props {
  title: string;
  subtitle: string;
  icon: typeof Users;
  class?: string;
}

const { title, subtitle, icon: Icon, class: className = '' } = Astro.props;
---

<div
  class:list={[
    'border-border bg-surface flex items-center gap-4 rounded-xl border p-4',
    className,
  ]}
>
  <div
    class='bg-surface-accent flex h-10 w-10 items-center justify-center rounded-lg'
  >
    <Icon class='text-icon h-5 w-5' />
  </div>

  <div>
    <h4 class='text-foreground font-semibold'>{title}</h4>
    <p class='text-foreground-muted text-xs'>{subtitle}</p>
  </div>
</div>
