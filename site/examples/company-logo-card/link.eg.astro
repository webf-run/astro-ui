---
import { CompanyLogoCard } from '@webf/astro-ui';

import GoogleLogo from '../../assets/company-logos/google.svg';
import GitHubLogo from '../../assets/company-logos/github.svg';
import DropboxLogo from '../../assets/company-logos/dropbox.svg';
import AmazonLogo from '../../assets/company-logos/amazon.svg';
---

<div class:list={['grid grid-cols-2 gap-4 md:grid-cols-4']}>
  <CompanyLogoCard
    href='https://google.com'
    variant='default'
    companyName='Google'
    logo={GoogleLogo}
  />

  <CompanyLogoCard
    href='https://github.com'
    variant='neutral'
    companyName='GitHub'
    logo={GitHubLogo}
  />

  <CompanyLogoCard
    href='https://dropbox.com'
    variant='blue'
    companyName='Microsoft'
    logo={DropboxLogo}
  />

  <CompanyLogoCard
    href='https://amazon.com'
    variant='purple'
    companyName='Figma'
    logo={AmazonLogo}
  />
</div>
