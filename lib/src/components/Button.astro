---
import { ArrowRight } from 'lucide-astro';

interface Props {
  variant?: 'primary' | 'secondary' | 'success' | 'purple' | 'blackwhite';
  size?: 'sm' | 'md' | 'lg';
  href?: string;
  disabled?: boolean;
  loading?: boolean;
  type?: 'button' | 'submit' | 'reset';
  class?: string;
  showIcon?: boolean;
  icon?: any;
}

const {
  variant = 'primary',
  size = 'md',
  href,
  disabled = false,
  loading = false,
  type = 'button',
  class: className = '',
  showIcon = false,
  icon: Icon,
} = Astro.props;

const baseClasses = `
  inline-flex
  items-center
  justify-center
  gap-2
  rounded-lg
  font-semibold
  transition-all
  duration-300
  focus:outline-none
  focus:ring-2
`;

// const variants = {
//   primary: `
//     bg-orange-400
//     text-black
//   `,

//   secondary: `
//     bg-white
//     text-purple-700
//     border
//     border-shellino-purple-200

//   `,
//   success: `
//     bg-transparent
//     border border-white
//     text-white
//   `,
//   purple: `
//     bg-shellino-purple-500
//     text-white
//     border
//     border-shellino-purple-200
//     rounded-md text-sm
//     transition

//   `,
//   blackwhite: `
//     bg-white
//     text-shellino-neutral-500
//     text-sm
//     border
//     border-shellino-neutral-300

//   `,
// };
const variants = {
  primary: `
    bg-orange-400
    text-black
  `,

  secondary: `
    bg-white
    text-purple-700
    border
    border-purple-200
  `,

  success: `
    bg-transparent
    border
    border-white
    text-white
  `,

  purple: `
    bg-purple-800
    text-white
    border
    border-purple-200
    rounded-md
    text-sm
    transition
  `,

  blackwhite: `
    bg-white
    text-gray-600
    text-sm
    border
    border-gray-300
  `,
};
const sizes = {
  sm: 'px-4 py-2 text-sm',
  md: 'px-6 py-3 text-[14px]',
  lg: 'px-8 py-4 text-lg',
};

const disabledClasses =
  disabled || loading
    ? 'opacity-50 cursor-not-allowed pointer-events-none'
    : '';

const buttonClasses = `
  ${baseClasses}
  ${variants[variant]}
  ${sizes[size]}
  ${disabledClasses}
  ${className}
`;
---

{
  href ? (
    <a href={href} class={buttonClasses} aria-disabled={disabled}>
      <span>{loading ? 'Loading...' : <slot />}</span>

      {showIcon && !loading && <ArrowRight size={18} />}
    </a>
  ) : (
    <button type={type} disabled={disabled || loading} class={buttonClasses}>
      <span>{loading ? 'Loading...' : <slot />}</span>

      {showIcon && !loading && <ArrowRight size={18} />}
      {Icon && <Icon size={16} strokeWidth={2} />}
    </button>
  )
}
