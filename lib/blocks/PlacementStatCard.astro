---
import { Users } from 'lucide-astro';

interface Props {
  icon: typeof Users;
  value: string;
  title: string;
  subtitle: string;
  class?: string;
}

const {
  icon: Icon,
  value,
  title,
  subtitle,
  class: className = '',
}: Props = Astro.props;
---

<div
  class='w-full rounded-2xl border border-violet-100 bg-purple-100 px-6 py-5 text-center md:w-45'
>
  <div
    class='mx-auto mb-3 flex h-10 w-10 items-center justify-center rounded-full bg-purple-400!'
  >
    <Icon class='h-4 w-4 text-violet-800' />
  </div>

  <h3 class='text-2xl font-bold text-black'>
    {value}
  </h3>

  <p class='mt-2 text-sm font-semibold text-black'>
    {title}
  </p>

  <p class='mt-1 text-[11px] text-zinc-700'>
    {subtitle}
  </p>
</div>
