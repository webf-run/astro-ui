---
import { CompanyLogoCard } from '@webf/astro-ui';
---

<div class:list={['flex flex-wrap items-center gap-6']}>
  <CompanyLogoCard
    size='md'
    effect='lift'
    companyName='Google'
    logo='https://cdn.simpleicons.org/google'
  />
  <CompanyLogoCard
    size='md'
    effect='scale'
    companyName='GitHub'
    logo='https://cdn.simpleicons.org/github'
  />
  <CompanyLogoCard
    size='md'
    effect='none'
    companyName='Microsoft'
    logo='https://cdn.simpleicons.org/microsoft'
  />
</div>
