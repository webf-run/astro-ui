---
import { ChevronDown } from 'lucide-astro';
import Button from './Button.astro';

interface NavItem {
  label: string;
  href: string;
  hasDropdown?: boolean;
}

interface Props {
  logoSrc?: string;
  logoText?: string;
  navItems?: NavItem[];
  class?: string;
  style?: string;
  position?: 'fixed' | 'sticky' | 'static';
}

const {
  logoSrc,
  logoText,
  navItems = [],
  class: className = '',
  style = '',
  position = 'fixed',
  ...rest
} = Astro.props;
---

<nav
  class:list={[
    'left-0 w-full bg-white shadow-sm',
    {
      'fixed top-0 z-50': position === 'fixed',
      'sticky top-0 z-50': position === 'sticky',
      relative: position === 'static',
    },
  ]}
>
  <div class='mx-auto max-w-screen-2xl px-8'>
    <div class='flex h-20 items-center justify-between'>
      <a href='/' class='flex items-center' style={style}>
        {
          logoSrc && (
            <img src={logoSrc} alt='Logo' class='h-12 w-auto object-contain' />
          )
        }

        {
          !logoSrc && logoText && (
            <span class='text-2xl font-bold text-gray-900'>{logoText}</span>
          )
        }
      </a>

      <div class='flex items-center gap-8' style={style}>
        {
          navItems.map((item) => (
            <a
              href={item.href}
              class={`flex items-center gap-1 text-[15px] font-medium transition-colors ${className}`}
            >
              <span>{item.label}</span>

              {item.hasDropdown && <ChevronDown size={16} strokeWidth={2} />}
            </a>
          ))
        }
      </div>

      <div class='flex items-center gap-5' style={style}>
        <Button variant='purple'> Apply Now </Button>
      </div>
    </div>
  </div>
</nav>
