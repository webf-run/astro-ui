---
import type { Users } from 'lucide-astro';

interface Props {
  icon: typeof Users;
  value: string;
  label: string;
}

const { icon: Icon, value, label }: Props = Astro.props;
---

<div
  class='rounded-xl
    px-3 py-4
    text-center
    w-full
    sm:max-w-[220px]
    lg:max-w-none
    mx-auto
    bg-purple-100
    border border-violet-100'
>
  <Icon class='w-5 h-5 mx-auto mb-2 text-violet-800' />

  <h3 class='font-bold text-lg sm:text-xl whitespace-nowrap'>
    {value}
  </h3>

  <p class='text-xs text-zinc-700'>
    {label}
  </p>
</div>
