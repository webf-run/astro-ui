---
import { Users } from 'lucide-astro';

interface Props {
  title: string;
  subtitle: string;
  icon: typeof Users;
  class?: string;
}

const { title, subtitle, icon: Icon, class: className = '' } = Astro.props;
---

<div
  class='flex items-center gap-4 rounded-xl border border-violet-100 bg-white p-4'
>
  <div
    class={`w-10 h-10
    rounded-lg
    flex items-center justify-center
    bg-purple-200`}
  >
    <Icon class='h-5 w-5 text-violet-800' />
  </div>

  <div>
    <h4 class='font-semibold'>
      {title}
    </h4>

    <p class='text-xs text-neutral-700'>
      {subtitle}
    </p>
  </div>
</div>
