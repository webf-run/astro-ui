---
import { Badge } from '@webf/astro-ui';
---

<Badge style='background-color:#dbeafe;color:#1d4ed8;border:1px solid #93c5fd'>
  New Arrival
</Badge>

<Badge
  style='background-color:#fef3c7;color:#92400e;box-shadow:0 4px 10px rgba(146,64,14,.18)'
>
  Best Seller
</Badge>

<Badge
  style='background-color:#fce7f3;color:#9d174d;border:1px solid #f9a8d4;text-transform:uppercase'
>
  Trending
</Badge>

<Badge style='background-color:#111827;color:#fff;letter-spacing:.08em'>
  Members Only
</Badge>
