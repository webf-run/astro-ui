---
interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<span
  class:list={[
    'bg-badge-purple-background text-badge-purple-foreground inline-flex items-center justify-center rounded-full px-4 py-3 text-xs font-semibold tracking-widest',
    className,
  ]}
>
  <slot />
</span>
