---
import { Users } from 'lucide-astro';

interface Props {
  icon: typeof Users;
  value: string;
  title: string;
  subtitle: string;
  class?: string;
}

const {
  icon: Icon,
  value,
  title,
  subtitle,
  class: className = '',
}: Props = Astro.props;
---

<div
  class='rounded-2xl
  px-6 py-5
  w-full
  md:w-45
  text-center
  bg-purple-100
  border
  border-violet-100'
>
  <div
    class='bg-purple-400! rounded-full w-10 h-10 flex items-center justify-center mx-auto mb-3'
  >
    <Icon class='w-4 h-4 text-violet-800' />
  </div>

  <h3 class='text-2xl font-bold text-black'>
    {value}
  </h3>

  <p class='mt-2 text-sm font-semibold text-black'>
    {title}
  </p>

  <p class='mt-1 text-[11px] text-zinc-700'>
    {subtitle}
  </p>
</div>
