---
import { CompanyLogoCard } from '@webf/astro-ui';

import GoogleLogo from '../../assets/company-logos/google.svg';
import GitHubLogo from '../../assets/company-logos/github.svg';
import DropboxLogo from '../../assets/company-logos/dropbox.svg';
---

<div class='flex items-center gap-4 overflow-x-auto'>
  <CompanyLogoCard
    size='sm'
    variant='blue'
    companyName='Microsoft'
    logo={GoogleLogo}
  />

  <CompanyLogoCard
    size='md'
    variant='purple'
    companyName='Figma'
    logo={GitHubLogo}
  />

  <CompanyLogoCard
    size='lg'
    variant='neutral'
    companyName='Google'
    logo={DropboxLogo}
  />
</div>
