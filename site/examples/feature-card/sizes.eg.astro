---
import { FeatureCard } from '@webf/astro-ui';
import { Boxes } from 'lucide-astro';
---

<div class:list={['grid gap-4']}>
  <FeatureCard size='sm' title='Small card' subtitle='Compact sidebar feature.' icon={Boxes} />
  <FeatureCard size='md' title='Medium card' subtitle='Balanced default layout.' icon={Boxes} />
  <FeatureCard size='lg' title='Large card' subtitle='Prominent landing-page feature.' icon={Boxes} />
</div>
