---
import { CompanyLogoCard } from '@webf/astro-ui';

import GoogleLogo from '../../assets/company-logos/google.svg';
import GitHubLogo from '../../assets/company-logos/github.svg';
import DropboxLogo from '../../assets/company-logos/dropbox.svg';
import AmazonLogo from '../../assets/company-logos/amazon.svg';
---

<div class:list={['grid grid-cols-2 gap-4 sm:grid-cols-3 md:grid-cols-4']}>
  <CompanyLogoCard companyName='Google' logo={GoogleLogo} />

  <CompanyLogoCard companyName='GitHub' logo={GitHubLogo} />

  <CompanyLogoCard companyName='Microsoft' logo={DropboxLogo} />

  <CompanyLogoCard companyName='Amazon' logo={AmazonLogo} />
</div>
