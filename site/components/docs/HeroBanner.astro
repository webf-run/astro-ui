---
import { ArrowRight, Code2, Sparkles } from 'lucide-astro';

const installCode = `npm create astro-ui@latest`;

const astroCode = `---
import { Button } from "@astro-ui/astro";
---

<Button>Hello World</Button>`;
---

<section
  class:list={[
    'relative mx-auto box-border grid w-full grid-cols-1 gap-8 py-5',
    'lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)]',
  ]}
>
  <!-- BACKGROUND -->
  <div
    class:list={[
      'absolute -inset-52 -z-[1] blur-[40px]',
      'bg-[radial-gradient(circle_at_20%_20%,rgba(99,102,241,0.15),transparent_45%),radial-gradient(circle_at_80%_60%,rgba(236,72,153,0.12),transparent_45%)]',
    ]}
  >
  </div>

  <!-- LEFT -->
  <!-- LEFT -->
  <div class:list={['flex min-w-0 flex-col justify-center gap-5']}>
    <!-- BADGE -->
    <a
      href='/docs'
      class:list={[
        'inline-flex w-fit items-center gap-2.5 rounded-full',
        'border border-[color:var(--sl-color-gray-5)]',
        'bg-[color-mix(in_srgb,var(--sl-color-bg-nav)_70%,transparent)]',
        'px-4 py-2.5 text-[color:var(--sl-color-text)] backdrop-blur-md',
        'no-underline transition-all duration-[250ms]',
        'hover:-translate-y-0.5',
      ]}
    >
      <Sparkles />

      <span>Introducing Astro UI</span>

      <ArrowRight />
    </a>

    <!-- HEADING -->
    <h1
      class:list={[
        '!mt-2.5 text-[42px] leading-[1.05] font-extrabold tracking-[-2px]',
        'lg:text-[54px]',
      ]}
    >
      <span
        class:list={[
          'bg-gradient-to-r from-[#7c3aed] to-[#3b82f6]',
          'bg-clip-text text-transparent',
        ]}
      >
        Astro UI
      </span>

      <span class:list={['ml-2']}>component library</span>
    </h1>

    <!-- DESCRIPTION -->
    <p class:list={['max-w-[520px] text-[18px] opacity-75']}>
      Build modern, accessible and themeable UI components for Astro with
      production-ready patterns.
    </p>

    <!-- BUTTONS -->
    <div class:list={['flex gap-3']}>
      <!-- GET STARTED -->
      <a
        href='/getting-started/installation'
        class:list={[
          'rounded-[10px] px-[18px] py-3 font-semibold no-underline',
          '!bg-[var(--sl-color-text)] !text-[var(--sl-color-bg)]',
          'transition-all duration-[250ms]',
          'hover:-translate-y-[3px]',
          'hover:shadow-[0_10px_30px_rgba(0,0,0,0.12)]',
        ]}
      >
        Get Started
      </a>

      <!-- COMPONENTS -->
      <a
        href='/components/button'
        class:list={[
          'rounded-[10px] px-[18px] py-3 font-semibold no-underline',
          '!bg-[var(--sl-color-gray-6)] !text-[var(--sl-color-text)]',
          'transition-all duration-[250ms]',
          'hover:-translate-y-[3px]',
          'hover:shadow-[0_10px_30px_rgba(0,0,0,0.12)]',
        ]}
      >
        Components
      </a>

      <!-- GITHUB -->
      <a
        href='https://github.com'
        class:list={[
          'rounded-[10px] border px-[18px] py-3 font-semibold no-underline',
          '!border-[var(--sl-color-gray-5)]',
          '!bg-transparent !text-[var(--sl-color-text)]',
          'transition-all duration-[250ms]',
          'hover:-translate-y-[3px]',
          'hover:bg-[var(--sl-color-gray-6)]',
          'hover:shadow-[0_10px_30px_rgba(0,0,0,0.12)]',
        ]}
      >
        GitHub
      </a>
    </div>
  </div>
  <!-- RIGHT -->
  <div
    class:list={[
      'mt-5 flex h-full min-w-0 flex-col justify-between',
      'lg:mt-0',
    ]}
  >
    <!-- INSTALL CARD -->
    <div
      class:list={[
        'flex w-full min-w-0 flex-1 flex-col rounded-2xl',
        'border border-[color:var(--sl-color-gray-5)]',
        'bg-[color-mix(in_srgb,var(--sl-color-bg-nav)_70%,transparent)]',
        'p-[15px] backdrop-blur-[14px]',
        'transition-all duration-[250ms] hover:-translate-y-1',
      ]}
    >
      <div class:list={['flex items-center gap-3']}>
        <div
          class:list={[
            'grid h-10 w-10 place-items-center rounded-xl',
            'bg-[color:var(--sl-color-gray-6)]',
          ]}
        >
          <Code2 />
        </div>

        <div>
          <h3 class:list={['m-0 text-[18px]']}>Install</h3>
          <p class:list={['m-0 text-sm opacity-60']}>
            Bootstrap your project instantly
          </p>
        </div>
      </div>

      <div
        class:list={[
          'w-full min-w-0 overflow-x-hidden rounded-[14px]',
          'border border-[color:var(--sl-color-gray-5)]',
          'bg-[#0b0b0b]',
        ]}
      >
        <pre
          class:list={[
            'm-0 w-full min-w-0 overflow-x-auto whitespace-pre',
            'text-sm text-[#e5e7eb]',
          ]}>{installCode}</pre>
      </div>
    </div>

    <!-- USE CARD -->
    <div
      class:list={[
        'flex w-full min-w-0 flex-1 flex-col rounded-2xl',
        'border border-[color:var(--sl-color-gray-5)]',
        'bg-[color-mix(in_srgb,var(--sl-color-bg-nav)_70%,transparent)]',
        'p-[15px] backdrop-blur-[14px]',
        'transition-all duration-[250ms] hover:-translate-y-1',
      ]}
    >
      <div class:list={['flex items-center gap-3']}>
        <div
          class:list={[
            'grid h-10 w-10 place-items-center rounded-xl',
            'bg-[color:var(--sl-color-gray-6)]',
          ]}
        >
          <Code2 />
        </div>

        <div>
          <h3 class:list={['m-0 text-[18px]']}>Use</h3>
          <p class:list={['m-0 text-sm opacity-60']}>Drop-in components</p>
        </div>
      </div>

      <div
        class:list={[
          'w-full min-w-0 overflow-x-hidden rounded-[14px]',
          'border border-[color:var(--sl-color-gray-5)]',
          'bg-[#0b0b0b]',
        ]}
      >
        <pre
          class:list={[
            'm-0 w-full min-w-0 overflow-x-auto whitespace-pre',
            'text-sm text-[#e5e7eb]',
          ]}>{astroCode}</pre>
      </div>
    </div>
  </div>
</section>
