---
import { ChartNoAxesCombined, TrendingUp } from 'lucide-astro';
import { StatCard } from '@webf/astro-ui';
---

<div class:list={['grid gap-4 sm:grid-cols-2']}>
  <StatCard icon={TrendingUp} value='24%' label='Growth this quarter' />
  <StatCard
    variant='muted'
    icon={ChartNoAxesCombined}
    value='8.4k'
    label='Monthly visits'
  />
</div>
