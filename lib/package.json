{
  "name": "@webf/astro-ui",
  "version": "0.1.0",
  "description": "Reusable Astro UI components",
  "type": "module",
  "author": "WebF",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/webf-run/astro-ui.git"
  },
  "homepage": "https://github.com/webf-run/astro-ui",
  "bugs": {
    "url": "https://github.com/webf-run/astro-ui/issues"
  },
  "exports": {
    ".": "./src/index.ts",
    "./style.css": "./dist/style.css"
  },
  "files": [
    "src",
    "dist"
  ],
  "keywords": [
    "astro",
    "ui",
    "components",
    "tailwindcss"
  ],
  "scripts": {
    "dev": "astro dev",
    "preview": "astro preview",
    "build:css": "tailwindcss -i ./src/styles/index.css -o ./dist/style.css --minify",
    "build": "pnpm run build:css",
    "format": "prettier . --write",
    "format:check": "prettier . --check"
  },
  "peerDependencies": {
    "astro": "^7.0.0",
    "lucide-astro": "^0.556.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.2",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "astro": "^7.0.0",
    "prettier": "^3.9.4",
    "prettier-plugin-astro": "^0.14.1",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3"
  }
}
