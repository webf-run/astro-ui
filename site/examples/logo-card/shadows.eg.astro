---
import { LogoCard } from '@webf/astro-ui';
---

<div style='display:flex;flex-wrap:wrap;gap:1rem;padding:1rem'>
  <LogoCard
    logo='https://upload.wikimedia.org/wikipedia/commons/2/2f/Google_2015_logo.svg'
    companyName='Google'
    size='md'
    variant='default'
    style='box-shadow:0 2px 6px rgba(37,99,235,.18)'
  />

  <LogoCard
    logo='https://upload.wikimedia.org/wikipedia/commons/2/26/Spotify_logo_with_text.svg'
    companyName='Spotify'
    size='md'
    variant='default'
    style='box-shadow:0 10px 20px rgba(16,185,129,.20)'
  />

  <LogoCard
    logo='https://upload.wikimedia.org/wikipedia/commons/7/7a/Logonetflix.png'
    companyName='Netflix'
    size='md'
    variant='default'
    style='box-shadow:0 0 35px rgba(59,130,246,.35)'
  />
</div>
