---
import type { Users } from 'lucide-astro';

interface Props {
  icon: typeof Users;
  value: string;
  label: string;
}

const { icon: Icon, value, label }: Props = Astro.props;
---

<div
  class='mx-auto w-full rounded-xl border border-violet-100 bg-purple-100 px-3 py-4 text-center sm:max-w-[220px] lg:max-w-none'
>
  <Icon class='mx-auto mb-2 h-5 w-5 text-violet-800' />

  <h3 class='text-lg font-bold whitespace-nowrap sm:text-xl'>
    {value}
  </h3>

  <p class='text-xs text-zinc-700'>
    {label}
  </p>
</div>
